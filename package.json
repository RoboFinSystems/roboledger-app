{
  "name": "roboledger-app",
  "version": "1.0.19",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "create-feature": "./bin/create-feature.sh",
    "create-release": "./bin/create-release.sh",
    "gha-setup": "./bin/gha-setup.sh"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "next start",
    "dev": "PORT=3001 next dev",
    "dev:webpack": "PORT=3001 next dev --webpack",
    "tunnel:ngrok": "./bin/tunnel-ngrok.sh",
    "tunnel:cloudflared": "./bin/tunnel-cloudflared.sh",
    "build": "next build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --silent",
    "test:all": "npm run test && npm run format && npm run lint:fix && npm run typecheck && npm run cf-lint",
    "cf-lint": "uvx cfn-lint",
    "test:watch": "vitest watch --silent",
    "test:coverage": "vitest run --coverage --silent",
    "deploy:staging": "./bin/deploy.sh staging",
    "deploy:prod": "./bin/deploy.sh prod",
    "feature:create": "./bin/create-feature.sh",
    "release:create": "./bin/create-release.sh",
    "setup:gha": "./bin/gha-setup.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1121.0",
    "@robosystems/client": "^1.14.1",
    "@robosystems/core": "^0.8.8",
    "@robosystems/report-components": "^0.4.1",
    "flowbite": "^3.1",
    "flowbite-react": "^0.12.5",
    "lru-cache": "^11.5.1",
    "next": "^16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5",
    "react-markdown": "^10",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3"
  },
  "//overrides": "deepmerge-ts is forced to ^8 to clear GHSA-ggr8-5vv4-36mx. It reaches us only through flowbite-react, which pins 7.1.5 exactly; npm's only other remedy is downgrading flowbite-react. REMOVE once flowbite-react ships a release depending on deepmerge-ts 8.",
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prettier": "^3",
    "prettier-plugin-organize-imports": "^4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  }
}
